      "name": "icon",
      "label": "Icône à droite",
      "type": "boolean",
      "default": true,
      "code": {
        "react": "icon={{v}}"
      }
    },
    {
      "name": "loading",
      "label": "Chargement",
      "type": "boolean",
      "default": false,
      "code": {
        "html": "aria-busy=\"{v}\"",
        "react": "loading={{v}}"
      }
    },
    {
      "name": "disabled",
      "label": "Désactivé",
      "type": "boolean",
      "default": false,
      "code": {
        "react": "disabled={{v}}"
      }
    }
