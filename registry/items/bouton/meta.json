        },
        {
          "value": "md",
          "label": "40 px"
        },
        {
          "value": "lg",
          "label": "48 px"
        }
      ],
      "hint": "Sur mobile, la taille moyenne passe à 44 px ; la petite garde une zone tactile de 44 px.",
      "code": {
        "html": "data-size=\"{v}\"",
        "react": "size=\"{v}\""
      }
    },
    {
      "name": "label",
      "label": "Libellé",
      "type": "text",
      "default": "Continuer",
      "code": {
        "html": "<span class=\"btn__label\">{v}</span>",
        "react": "      {v}\n    </Button>"
      }
