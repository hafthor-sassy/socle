      }
    },
    {
      "name": "succes",
      "label": "Libellé de succès",
      "type": "text",
      "default": "Virement envoyé",
      "code": {
        "html": "<span>{v}</span>",
        "react": "successLabel=\"{v}\""
      }
    },
    {
      "name": "issue",
      "label": "Issue simulée",
