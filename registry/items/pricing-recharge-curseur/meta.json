      "code": {
        "html": "data-tiers=\"{v}\"",
        "react": "tiers={[{v}]}"
      }
    },
    {
      "name": "bonus",
      "label": "Bonus par palier (%)",
      "type": "text",
      "default": "0, 5, 10, 20",
